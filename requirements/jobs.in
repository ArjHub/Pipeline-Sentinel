# Runtime deps for Spark jobs, the Glue job, and Great Expectations validation.
# Installed into an isolated venv (/opt/venv/jobs) inside the Airflow image so job
# dependencies never fight Airflow's own constraint set.
#
# Spark/Delta versions deliberately mirror AWS Glue 5.0 (Spark 3.5.4, Delta 3.3.0,
# Python 3.11) so the same code runs locally and on real Glue.
# Compile the lock with: make lock
pyspark==3.5.4
delta-spark==3.3.0
deltalake==1.6.6
great-expectations==1.24.0
pandas==2.2.3
numpy==1.26.4
pyarrow==17.0.0
pydantic==2.11.7
# Event stream (Phase 2). Same versions as Airflow 2.11.2's constraints, so the Airflow
# env (callbacks) and this venv use an identical Kafka client.
confluent-kafka==2.13.2
prometheus-client==0.24.1
# Diagnosis agent + Slack interactivity API (Phase 4). Released >= 2 weeks before
# pinning; `make lock` also excludes anything newer than LOCK_EXCLUDE_NEWER.
anthropic==1.13.0
fastapi==0.143.0
uvicorn==0.54.0
