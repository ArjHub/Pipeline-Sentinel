# Copy to .env (`make env` does this and fills random secrets). Never commit .env.

# --- Local stack secrets (random per clone) ---
POSTGRES_PASSWORD=change-me
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Container user for bind-mounted files (set to your host uid by `make env`).
AIRFLOW_UID=50000

# --- Pipelines ---
SENTINEL_SEED=42
SPARK_DRIVER_MEMORY=1g

# --- Diagnosis agent (Phase 4) ---
ANTHROPIC_API_KEY=
SENTINEL_LLM_MODEL=claude-haiku-5-5
SENTINEL_JUDGE_MODEL=claude-haiku-5-5
SENTINEL_LLM_BUDGET_USD=10

# --- Slack (Phase 4; leave empty to use the local mock) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=
